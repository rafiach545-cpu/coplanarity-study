diff --git a/quirkcore/include/quirkcore/QuirkEq3Pair.h b/quirkcore/include/quirkcore/QuirkEq3Pair.h
new file mode 100644
index 0000000..e69dd36
--- /dev/null
+++ b/quirkcore/include/quirkcore/QuirkEq3Pair.h
@@ -0,0 +1,90 @@
+#ifndef QUIRKCORE_QuirkEq3Pair_H
+#define QUIRKCORE_QuirkEq3Pair_H
+// 09 patch (2026-11-24): /quirk/model eq3. Eq. 3 of arXiv:1708.02243 (Nambu-Goto end-point equation of Kang-Luty and Knapen et al.)
+// for the quirk pair, integrated jointly by quirkeq3::Solver (the production DOP853, bitwise equal to the numba module, G14), and
+// replayed by the two Geant4 tracks through QuirkEq3Stepper. Design: coplanarity_study/09_.../g4/G4_EQ3_DESIGN.md.
+//  - Both tracks register at their first step (initial position, momentum, charge, mass, time).
+//  - The pair is integrated in whole DOP853 steps over time slices [t_H, t_H + slice]; each track replays its quirk's dense output as a
+//    function of its path length s, up to the slice end (the horizon). A track at the horizon whose partner is not there yet is
+//    suspended (QuirkWatcher), as the Athena model does when its string runs out; when both are there, the next slice is integrated.
+//  - Without material the integrator state is carried over unchanged from slice to slice, so the trajectory is exactly the continuous
+//    DOP853 solution. At a slice start the actual Geant4 states are compared with it; if they differ (energy loss, multiple
+//    scattering) the integrator restarts from the two actual states. Kicks inside a slice reach the partner only at the next slice
+//    (error of order slice x kick; to be checked with slice, slice/2, slice/4 in Stage 2).
+//  - Uniform Bz from the detector field at the production point (the Stage 1 ideal geometry has a uniform 2 T field).
+//  - No random numbers.
+// Units: Geant4 internal units outside, natural units (GeV, GeV^-1) inside, with the conversion constants of the Python code.
+#include "quirkcore/QuirkEq3Dop853.h"
+#include "G4ThreeVector.hh"
+#include "globals.hh"
+#include <algorithm>
+#include <deque>
+#include <memory>
+
+class G4Track;
+
+class QuirkEq3Pair {
+public:
+  static QuirkEq3Pair& instance();
+  // settings (QuirkMessenger, QuirkPhysics); process wide, set in PreInit
+  static void SetEnabled(G4bool on) { s_enabled = on; }
+  static G4bool Enabled() { return s_enabled; }
+  static void SetRtol(G4double rtol) { s_rtol = rtol; }
+  static G4double Rtol() { return s_rtol; }
+  static void SetSlice(G4double slice) { s_slice = slice; }      // Geant4 time units
+  static G4double Slice() { return s_slice; }
+  static void SetLambda(G4double lambda) { s_lambda = lambda; }  // Geant4 energy units
+  static int Index(G4int pdg) { return pdg > 0 ? 0 : 1; }        // as QuirkStringStore
+
+  void StartTracking(const G4Track& track);                      // registration at step 0 (a new event clears the pair)
+  // true if track idx has trajectory beyond its current path length; integrates the next slice when both quirks are at the horizon
+  G4bool Ensure(int idx, const G4Track& track);
+  G4double MaxLength(int idx) const;                             // path length from the current position to the horizon (mm)
+  G4double PathNow(int idx) const { return m_sCur[idx]; }
+  // state at absolute path length s (Geant4 units) in the QuirkHyperbolaStepper layout: x, y, z, px, py, pz, Ekin, t_lab (y[8] untouched)
+  void StateAt(int idx, G4double s, G4double y[9]) const;
+  void Advance(int idx, G4double ds) { m_sCur[idx] += ds; }
+  void Killed(int idx) { m_alive[idx] = false; PrintCounters("track end"); }
+  G4bool Alive(int idx) const { return m_alive[idx]; }
+  G4bool Registered(int idx) const { return m_reg[idx]; }
+  long Restarts() const { return m_restarts; }
+  // debug counters (QUIRK_EQ3_DEBUG; no effect on the result)
+  void NoteStepperBeyond(G4double excess) const { ++m_nStepBeyond; m_maxStepBeyond = std::max(m_maxStepBeyond, excess); }
+  void PrintCounters(const char* where) const;
+  QuirkEq3Pair(const QuirkEq3Pair&) = delete;
+  QuirkEq3Pair& operator=(const QuirkEq3Pair&) = delete;
+
+private:
+  QuirkEq3Pair() = default;
+  struct StepRec {
+    double t_old, h;                 // natural units, absolute time (t_old includes the restart offset)
+    double y_old[12], F[7][12];
+    double s0[2], s1[2];             // path length (mm) of each slot at the step start and end
+  };
+  void Clear();
+  void IntegrateSlice();
+  void NewSolver(const double t0_nat);
+  double PathInStep(const StepRec& r, int slot, double x) const;   // mm from the step start to fraction x
+  G4bool AtHorizon(int idx) const;
+
+  static G4bool s_enabled;
+  static G4double s_rtol, s_slice, s_lambda;
+  G4int m_event{-1};
+  G4bool m_reg[2]{false, false}, m_alive[2]{true, true};
+  int m_slot[2]{0, 1};               // y slot of each pdg index: slot 0 = the positive charge (the Python codes' particle 1)
+  G4double m_mass{0};                // Geant4 units
+  G4double m_t0{0};                  // Geant4 time of t_nat = 0
+  G4ThreeVector m_x[2], m_p[2];      // registered / actual states (Geant4 units)
+  G4double m_q[2]{0, 0};             // charge in units of e
+  quirkeq3::Params m_par;
+  double m_atol[12]{};
+  std::unique_ptr<quirkeq3::Solver> m_solver;
+  double m_tOffset{0};               // natural time of the solver's t = 0
+  std::deque<StepRec> m_steps;
+  G4double m_sCur[2]{0, 0}, m_sH[2]{0, 0};
+  long m_restarts{0};
+  mutable long m_nStateAt{0}, m_nClamp{0}, m_nStepBeyond{0};
+  mutable G4double m_maxClamp{0}, m_maxStepBeyond{0};
+};
+
+#endif
diff --git a/quirkcore/include/quirkcore/QuirkEq3Stepper.h b/quirkcore/include/quirkcore/QuirkEq3Stepper.h
new file mode 100644
index 0000000..50c5d2d
--- /dev/null
+++ b/quirkcore/include/quirkcore/QuirkEq3Stepper.h
@@ -0,0 +1,39 @@
+#ifndef QUIRKCORE_QuirkEq3Stepper_H
+#define QUIRKCORE_QuirkEq3Stepper_H
+// 09 patch (2026-11-24): fake G4MagIntegratorStepper for /quirk/model eq3, the counterpart of QuirkHyperbolaStepper.
+// It replays the quirk's Eq. 3 trajectory from QuirkEq3Pair as a function of the path length, so G4PropagatorInField finds the
+// boundary crossings on the exact (dense-output) trajectory. State layout as QuirkHyperbolaStepper: x, y, z, px, py, pz, Ekin,
+// t_lab, and in y[8] the path length since the start of the Geant4 step.
+#include "quirkcore/QuirkEq3Pair.h"
+#include "quirkcore/QuirkDummyEquation.h"
+#include "G4MagIntegratorStepper.hh"
+
+class QuirkEq3Stepper : public G4MagIntegratorStepper {
+public:
+  QuirkEq3Stepper(QuirkEq3Pair& pair, int idx)
+      : G4MagIntegratorStepper(new QuirkDummyEquation(), 9), m_pair(pair), m_idx(idx), m_s0(pair.PathNow(idx)), m_maxLen(pair.MaxLength(idx)) {}
+  ~QuirkEq3Stepper() override { delete GetEquationOfMotion(); }
+  void Stepper(const G4double y[], const G4double[], G4double h, G4double yout[], G4double yerr[]) override {
+    const G4double len = y[8] + h;
+    if (len > m_maxLen) m_pair.NoteStepperBeyond(len - m_maxLen);    // debug counter only
+    m_pair.StateAt(m_idx, m_s0 + len, yout);
+    yout[8] = len;
+    for (int i = 0; i < 9; ++i) yerr[i] = 0;
+  }
+  G4double DistChord() const override { return 0; }
+  G4int IntegratorOrder() const override { return 1; }
+  G4double GetMaxLength() const { return m_pair.MaxLength(m_idx); }
+  // the state at the start of the step plus len along the trajectory, into the field track
+  void StateAtLength(G4double len, G4double y9[9]) const {
+    m_pair.StateAt(m_idx, m_s0 + len, y9);
+    y9[8] = len;
+  }
+
+private:
+  QuirkEq3Pair& m_pair;
+  const int m_idx;
+  const G4double m_s0;
+  const G4double m_maxLen;
+};
+
+#endif
diff --git a/quirkcore/src/QuirkEq3Dop853.cc b/quirkcore/src/QuirkEq3Dop853.cc
new file mode 100644
index 0000000..988836b
--- /dev/null
+++ b/quirkcore/src/QuirkEq3Dop853.cc
@@ -0,0 +1,264 @@
+// Eq. 3 DOP853 (09 patch, 2026-11-24): line-by-line port of 03_trajectory_sim/quirk_trajectory_dop853.py; see the header.
+#include "quirkcore/QuirkEq3Dop853.h"
+#include "quirkcore/QuirkEq3Dop853Coeffs.h"
+#include <cmath>
+#include <limits>
+#include <algorithm>
+
+namespace quirkeq3 {
+
+namespace {
+constexpr int n = 12, NST = N_STAGES, NEXT = N_STAGES_EXTENDED, NPOW = INTERPOLATOR_POWER;
+static_assert(NPOW == 7, "Solver::F is sized for INTERPOLATOR_POWER 7");
+
+// quirk_trajectory_numba._string_force
+inline void StringForce(double vx, double vy, double vz, double nx, double ny, double nz, double L2, double& fx, double& fy, double& fz) {
+  const double vpar = vx * nx + vy * ny + vz * nz;
+  const double vparx = vpar * nx, vpary = vpar * ny, vparz = vpar * nz;
+  const double vperpx = vx - vparx, vperpy = vy - vpary, vperpz = vz - vparz;
+  const double vperp2 = vperpx * vperpx + vperpy * vperpy + vperpz * vperpz;
+  const double st = std::sqrt(std::max(1.0 - vperp2, 1e-12));
+  const double t1x = st * nx, t1y = st * ny, t1z = st * nz;
+  const double coef = vpar / st;
+  const double t2x = coef * vperpx, t2y = coef * vperpy, t2z = coef * vperpz;
+  fx = -L2 * (t1x + t2x);
+  fy = -L2 * (t1y + t2y);
+  fz = -L2 * (t1z + t2z);
+}
+
+// quirk_trajectory_dop853._rr
+inline void Signs(const double y[12], const std::vector<double>& R2n, const std::vector<double>& Zn, std::vector<int8_t>& s) {
+  const double r1 = y[0] * y[0] + y[1] * y[1], r2 = y[6] * y[6] + y[7] * y[7];
+  const size_t nr = R2n.size(), nz = Zn.size();
+  s.assign(2 * (nr + nz), 0);
+  for (size_t k = 0; k < nr; ++k) {
+    s[k] = r1 > R2n[k] ? 1 : (r1 < R2n[k] ? -1 : 0);
+    s[nr + k] = r2 > R2n[k] ? 1 : (r2 < R2n[k] ? -1 : 0);
+  }
+  for (size_t k = 0; k < nz; ++k) {
+    s[2 * nr + k] = y[2] > Zn[k] ? 1 : (y[2] < Zn[k] ? -1 : 0);
+    s[2 * nr + nz + k] = y[8] > Zn[k] ? 1 : (y[8] < Zn[k] ? -1 : 0);
+  }
+}
+
+inline void Push(Result& R, double t, const double y[12]) {
+  R.T.push_back(t);
+  R.Y.insert(R.Y.end(), y, y + 12);
+}
+}  // namespace
+
+void Rhs(const double s[12], const Params& p, double out[12]) {
+  const double x1x = s[0], x1y = s[1], x1z = s[2], p1x = s[3], p1y = s[4], p1z = s[5];
+  const double x2x = s[6], x2y = s[7], x2z = s[8], p2x = s[9], p2y = s[10], p2z = s[11];
+  const double m2 = p.mass * p.mass;
+  const double E1 = std::sqrt(p1x * p1x + p1y * p1y + p1z * p1z + m2);
+  const double E2 = std::sqrt(p2x * p2x + p2y * p2y + p2z * p2z + m2);
+  const double v1x = p1x / E1, v1y = p1y / E1, v1z = p1z / E1;
+  const double v2x = p2x / E2, v2y = p2y / E2, v2z = p2z / E2;
+  const double sepx = x1x - x2x, sepy = x1y - x2y, sepz = x1z - x2z;
+  const double dist = std::sqrt(sepx * sepx + sepy * sepy + sepz * sepz);
+  double n1x, n1y, n1z;
+  if (dist < 1e-9) {
+    const double vrx = v1x - v2x, vry = v1y - v2y, vrz = v1z - v2z;
+    const double vrn = std::sqrt(vrx * vrx + vry * vry + vrz * vrz);
+    if (vrn > 1e-12) {
+      n1x = vrx / vrn; n1y = vry / vrn; n1z = vrz / vrn;
+    } else {
+      n1x = 1.0; n1y = 0.0; n1z = 0.0;
+    }
+  } else {
+    n1x = sepx / dist; n1y = sepy / dist; n1z = sepz / dist;
+  }
+  const double n2x = -n1x, n2y = -n1y, n2z = -n1z;
+  double F1x, F1y, F1z, F2x, F2y, F2z;
+  StringForce(v1x, v1y, v1z, n1x, n1y, n1z, p.L2, F1x, F1y, F1z);
+  F1x += p.q1 * p.Bz * v1y;
+  F1y += -p.q1 * p.Bz * v1x;
+  StringForce(v2x, v2y, v2z, n2x, n2y, n2z, p.L2, F2x, F2y, F2z);
+  F2x += p.q2 * p.Bz * v2y;
+  F2y += -p.q2 * p.Bz * v2x;
+  out[0] = v1x; out[1] = v1y; out[2] = v1z; out[3] = F1x; out[4] = F1y; out[5] = F1z;
+  out[6] = v2x; out[7] = v2y; out[8] = v2z; out[9] = F2x; out[10] = F2y; out[11] = F2z;
+}
+
+// quirk_trajectory_dop853._dense
+void Dense(const double F[7][12], const double y_old[12], double x, double out[12]) {
+  for (int j = 0; j < n; ++j) out[j] = 0.0;
+  for (int i = 0; i < NPOW; ++i) {
+    const double* f = F[NPOW - 1 - i];
+    for (int j = 0; j < n; ++j) out[j] += f[j];
+    if (i % 2 == 0) {
+      for (int j = 0; j < n; ++j) out[j] *= x;
+    } else {
+      for (int j = 0; j < n; ++j) out[j] *= (1.0 - x);
+    }
+  }
+  for (int j = 0; j < n; ++j) out[j] += y_old[j];
+}
+
+Solver::Solver(const double y0[12], double t_end_, const Params& p, double rtol, const double atol[12]) : m_p(p), m_rtol(rtol), t_end(t_end_) {
+  double tmp[n], fnew[n], sc[n];
+  for (int j = 0; j < n; ++j) { y[j] = y0[j]; m_atol[j] = atol[j]; }
+  t = 0.0;
+  Rhs(y, m_p, f);
+  // initial step (scipy select_initial_step, order = error_estimator_order = 7)
+  for (int j = 0; j < n; ++j) sc[j] = m_atol[j] + std::abs(y[j]) * m_rtol;
+  double d0 = 0.0, d1 = 0.0;
+  for (int j = 0; j < n; ++j) {
+    d0 += (y[j] / sc[j]) * (y[j] / sc[j]);
+    d1 += (f[j] / sc[j]) * (f[j] / sc[j]);
+  }
+  d0 = std::sqrt(d0 / n);
+  d1 = std::sqrt(d1 / n);
+  double h0 = (d0 < 1e-5 || d1 < 1e-5) ? 1e-6 : 0.01 * d0 / d1;
+  h0 = std::min(h0, t_end);
+  for (int j = 0; j < n; ++j) tmp[j] = y[j] + h0 * f[j];
+  Rhs(tmp, m_p, fnew);
+  double d2 = 0.0;
+  for (int j = 0; j < n; ++j) d2 += ((fnew[j] - f[j]) / sc[j]) * ((fnew[j] - f[j]) / sc[j]);
+  d2 = std::sqrt(d2 / n) / h0;
+  const double h1 = (d1 <= 1e-15 && d2 <= 1e-15) ? std::max(1e-6, h0 * 1e-3) : std::pow(0.01 / std::max(d1, d2), 1.0 / 8.0);
+  h_abs = std::min({100 * h0, h1, t_end});
+  nfev = 2;
+  for (int j = 0; j < n; ++j) y_old[j] = y[j];
+}
+
+int Solver::Step() {
+  double K[NEXT][n] = {};
+  double tmp[n], ynew[n], fnew[n];
+  const double min_step = 10 * std::abs(std::nextafter(t, std::numeric_limits<double>::infinity()) - t);
+  if (h_abs < min_step) h_abs = min_step;
+  bool rejected = false;
+  double t_new = 0;
+  while (true) {
+    if (h_abs < min_step) return -1;
+    t_new = t + h_abs;
+    if (t_new > t_end) t_new = t_end;
+    h = t_new - t;
+    h_abs = std::abs(h);
+    // rk_step
+    for (int j = 0; j < n; ++j) K[0][j] = f[j];
+    for (int s = 1; s < NST; ++s) {
+      for (int j = 0; j < n; ++j) {
+        double acc = 0.0;
+        for (int i = 0; i < s; ++i) acc += K[i][j] * A[s][i];
+        tmp[j] = y[j] + acc * h;
+      }
+      Rhs(tmp, m_p, K[s]);
+      ++nfev;
+    }
+    for (int j = 0; j < n; ++j) {
+      double acc = 0.0;
+      for (int i = 0; i < NST; ++i) acc += K[i][j] * B[i];
+      ynew[j] = y[j] + h * acc;
+    }
+    Rhs(ynew, m_p, fnew);
+    ++nfev;
+    for (int j = 0; j < n; ++j) K[NST][j] = fnew[j];
+    // error norm (scipy DOP853._estimate_error_norm)
+    double e5 = 0.0, e3 = 0.0;
+    for (int j = 0; j < n; ++j) {
+      const double scj = m_atol[j] + std::max(std::abs(y[j]), std::abs(ynew[j])) * m_rtol;
+      double a5 = 0.0, a3 = 0.0;
+      for (int i = 0; i < NST + 1; ++i) {
+        a5 += K[i][j] * E5[i];
+        a3 += K[i][j] * E3[i];
+      }
+      e5 += (a5 / scj) * (a5 / scj);
+      e3 += (a3 / scj) * (a3 / scj);
+    }
+    const double err = (e5 == 0.0 && e3 == 0.0) ? 0.0 : std::abs(h) * e5 / std::sqrt((e5 + 0.01 * e3) * n);
+    if (err < 1) {
+      double factor = (err == 0) ? 10.0 : std::min(10.0, 0.9 * std::pow(err, -1.0 / 8.0));
+      if (rejected) factor = std::min(1.0, factor);
+      h_abs *= factor;
+      break;
+    }
+    h_abs *= std::max(0.2, 0.9 * std::pow(err, -1.0 / 8.0));
+    rejected = true;
+    ++nrej;
+  }
+  ++nacc;
+  // dense output (scipy DOP853._dense_output_impl)
+  for (int s = NST + 1; s < NEXT; ++s) {
+    for (int j = 0; j < n; ++j) {
+      double acc = 0.0;
+      for (int i = 0; i < s; ++i) acc += K[i][j] * A[s][i];
+      tmp[j] = y[j] + acc * h;
+    }
+    Rhs(tmp, m_p, K[s]);
+    ++nfev;
+  }
+  for (int j = 0; j < n; ++j) {
+    const double dy = ynew[j] - y[j];
+    F[0][j] = dy;
+    F[1][j] = h * K[0][j] - dy;
+    F[2][j] = 2 * dy - h * (fnew[j] + K[0][j]);
+    for (int r = 0; r < NPOW - 3; ++r) {
+      double acc = 0.0;
+      for (int i = 0; i < NEXT; ++i) acc += D[r][i] * K[i][j];
+      F[3 + r][j] = h * acc;
+    }
+  }
+  t_old = t;
+  for (int j = 0; j < n; ++j) { y_old[j] = y[j]; y[j] = ynew[j]; f[j] = fnew[j]; }
+  t = t_new;
+  return 0;
+}
+
+Result Integrate(const double y0[12], double t_end, const Params& p, double rtol, const double atol[12],
+                 const std::vector<double>& R2n, const std::vector<double>& Zn, int ncoarse, int nfine, long max_out) {
+  Result R;
+  Solver S(y0, t_end, p, rtol, atol);
+  double yd[n], yd2[n];
+  Push(R, S.t, S.y);
+  const bool refine = !R2n.empty() || !Zn.empty();
+  std::vector<int8_t> sprev, scur;
+  auto fin = [&](int st) { R.status = st; R.nacc = S.nacc; R.nrej = S.nrej; R.nfev = S.nfev; return R; };
+  while (!S.Done()) {
+    if (S.Step() < 0) return fin(-1);
+    const double t = S.t_old, h = S.h, t_new = S.t;
+    // output: coarse points, refined where a radius or plane is crossed
+    if (refine) {
+      Signs(S.y_old, R2n, Zn, sprev);
+      double xprev = 0.0;
+      for (int c = 1; c <= ncoarse; ++c) {
+        const double xc = static_cast<double>(c) / ncoarse;
+        if (c == ncoarse) {
+          for (int j = 0; j < n; ++j) yd[j] = S.y[j];
+        } else {
+          Dense(S.F, S.y_old, xc, yd);
+        }
+        Signs(yd, R2n, Zn, scur);
+        if (scur != sprev) {
+          for (int q = 0; q <= nfine; ++q) {
+            const double xq = xprev + (xc - xprev) * q / nfine;
+            if (q == 0 && xprev == 0.0) continue;
+            Dense(S.F, S.y_old, xq, yd2);
+            const double tq = t + xq * h;
+            if (static_cast<long>(R.T.size()) >= max_out) return fin(-2);
+            if (R.T.back() == tq) continue;
+            Push(R, tq, yd2);
+          }
+        }
+        sprev = scur;
+        xprev = xc;
+      }
+    } else {
+      for (int c = 1; c < ncoarse; ++c) {
+        Dense(S.F, S.y_old, static_cast<double>(c) / ncoarse, yd);
+        if (static_cast<long>(R.T.size()) >= max_out) return fin(-2);
+        Push(R, t + static_cast<double>(c) / ncoarse * h, yd);
+      }
+    }
+    if (static_cast<long>(R.T.size()) >= max_out) return fin(-2);
+    if (R.T.back() != t_new) {
+      Push(R, t_new, S.y);
+    } else {
+      for (int j = 0; j < n; ++j) R.Y[R.Y.size() - 12 + j] = S.y[j];
+    }
+  }
+  return fin(0);
+}
+
+}  // namespace quirkeq3
diff --git a/quirkcore/src/QuirkEq3Pair.cc b/quirkcore/src/QuirkEq3Pair.cc
new file mode 100644
index 0000000..9a32758
--- /dev/null
+++ b/quirkcore/src/QuirkEq3Pair.cc
@@ -0,0 +1,218 @@
+// 09 patch (2026-11-24): Eq. 3 pair integration for /quirk/model eq3; see the header.
+#include "quirkcore/QuirkEq3Pair.h"
+#include "G4Track.hh"
+#include "G4DynamicParticle.hh"
+#include "G4EventManager.hh"
+#include "G4Event.hh"
+#include "G4TransportationManager.hh"
+#include "G4FieldManager.hh"
+#include "G4Field.hh"
+#include "G4Exception.hh"
+#include <CLHEP/Units/SystemOfUnits.h>
+#include "G4ios.hh"
+#include <cmath>
+#include <cstdlib>
+#include <algorithm>
+
+G4bool QuirkEq3Pair::s_enabled = false;
+G4double QuirkEq3Pair::s_rtol = 1e-10;
+G4double QuirkEq3Pair::s_slice = 0.1 * CLHEP::ns;
+G4double QuirkEq3Pair::s_lambda = 0.;
+
+namespace {
+// the constants of the Python code (03_trajectory_sim: CM, NS, TESLA_TO_GEV2, e_charge_natural)
+constexpr double CM = 1.973269804e-14;          // cm per GeV^-1
+constexpr double NS = 6.582119569e-16;          // ns per GeV^-1 (hbar = 6.582e-25 GeV s)
+constexpr double TESLA_TO_GEV2 = 1.9535e-16;
+constexpr double E_NAT = 0.30282212;
+constexpr double MM_PER_NAT = CM * 10.0;        // mm per GeV^-1
+constexpr double NS_PER_NAT = NS;               // ns per GeV^-1
+// 8-point Gauss-Legendre on [0, 1]
+constexpr double GLX[8] = {0.019855071751231856, 0.10166676129318664, 0.2372337950418355, 0.4082826787521751,
+                           0.5917173212478249, 0.7627662049581645, 0.8983332387068134, 0.9801449282487681};
+constexpr double GLW[8] = {0.05061426814518813, 0.11119051722668724, 0.15685332293894364, 0.18134189168918100,
+                           0.18134189168918100, 0.15685332293894364, 0.11119051722668724, 0.05061426814518813};
+inline double Speed(const double y[12], int slot, double m) {
+  const double* p = y + 6 * slot + 3;
+  const double p2 = p[0] * p[0] + p[1] * p[1] + p[2] * p[2];
+  return std::sqrt(p2) / std::sqrt(p2 + m * m);
+}
+}  // namespace
+
+QuirkEq3Pair& QuirkEq3Pair::instance() {
+  static thread_local QuirkEq3Pair pair;
+  return pair;
+}
+
+void QuirkEq3Pair::Clear() {
+  m_reg[0] = m_reg[1] = false;
+  m_alive[0] = m_alive[1] = true;
+  m_solver.reset();
+  m_steps.clear();
+  m_sCur[0] = m_sCur[1] = m_sH[0] = m_sH[1] = 0;
+  m_tOffset = 0;
+  m_restarts = 0;
+}
+
+void QuirkEq3Pair::StartTracking(const G4Track& track) {
+  if (track.GetCurrentStepNumber() != 0) return;                      // resumption of a suspended quirk
+  const G4Event* ev = G4EventManager::GetEventManager()->GetConstCurrentEvent();
+  const G4int evt = ev ? ev->GetEventID() : -1;
+  const int idx = Index(track.GetDefinition()->GetPDGEncoding());
+  if (evt != m_event || m_reg[idx]) { Clear(); m_event = evt; }        // new event (or a second pair in the same event)
+  m_reg[idx] = true;
+  m_x[idx] = track.GetPosition();
+  m_p[idx] = track.GetMomentum();
+  m_q[idx] = track.GetDynamicParticle()->GetCharge() / CLHEP::eplus;
+  m_mass = track.GetDynamicParticle()->GetMass();
+  if (!(m_reg[0] && m_reg[1])) { m_t0 = track.GetGlobalTime(); return; }
+  if (std::abs(track.GetGlobalTime() - m_t0) > 1e-9 * CLHEP::ns || (m_x[0] - m_x[1]).mag() > 1e-9 * CLHEP::mm) {
+    G4Exception("QuirkEq3Pair::StartTracking", "QuirkEq3Vertex", FatalException, "eq3: the two quirks must start at one point and one time");
+  }
+  m_slot[0] = (m_q[0] > 0 || (m_q[0] == m_q[1])) ? 0 : 1;              // slot 0 = the positive charge
+  m_slot[1] = 1 - m_slot[0];
+}
+
+void QuirkEq3Pair::NewSolver(const double t0_nat) {
+  double y0[12];
+  for (int idx = 0; idx < 2; ++idx) {
+    const int k = 6 * m_slot[idx];
+    y0[k + 0] = m_x[idx].x() / CLHEP::mm / MM_PER_NAT;
+    y0[k + 1] = m_x[idx].y() / CLHEP::mm / MM_PER_NAT;
+    y0[k + 2] = m_x[idx].z() / CLHEP::mm / MM_PER_NAT;
+    y0[k + 3] = m_p[idx].x() / CLHEP::GeV;
+    y0[k + 4] = m_p[idx].y() / CLHEP::GeV;
+    y0[k + 5] = m_p[idx].z() / CLHEP::GeV;
+  }
+  m_tOffset = t0_nat;
+  m_solver = std::make_unique<quirkeq3::Solver>(y0, 1e300, m_par, s_rtol, m_atol);
+}
+
+void QuirkEq3Pair::IntegrateSlice() {
+  if (!m_solver) {
+    m_par.mass = m_mass / CLHEP::GeV;
+    const int a = m_slot[0] == 0 ? 0 : 1;                               // pdg index in slot 0
+    m_par.q1 = m_q[a] * E_NAT;
+    m_par.q2 = m_q[1 - a] * E_NAT;
+    m_par.L2 = (s_lambda / CLHEP::GeV) * (s_lambda / CLHEP::GeV);
+    G4double B[6] = {0, 0, 0, 0, 0, 0};
+    const G4FieldManager* fm = G4TransportationManager::GetTransportationManager()->GetFieldManager();
+    if (fm && fm->GetDetectorField()) {
+      const G4double pt[4] = {m_x[0].x(), m_x[0].y(), m_x[0].z(), m_t0};
+      fm->GetDetectorField()->GetFieldValue(pt, B);
+    }
+    m_par.Bz = (B[2] / CLHEP::tesla) * TESLA_TO_GEV2;
+    for (int k = 0; k < 2; ++k) {
+      for (int j = 0; j < 3; ++j) m_atol[6 * k + j] = 1e-7 / CM * (s_rtol / 1e-10);      // 1 nm (quirk_trajectory_dop853.ATOL_X)
+      for (int j = 3; j < 6; ++j) m_atol[6 * k + j] = 1e-10 * (s_rtol / 1e-10);          // 1e-10 GeV (ATOL_P)
+    }
+    NewSolver(0.0);
+  } else {
+    // slice start: the actual Geant4 states against the integrator state (vacuum: equal)
+    G4bool same = true;
+    double dxs[2], dps[2];
+    for (int idx = 0; idx < 2; ++idx) {
+      const double* y = m_solver->y + 6 * m_slot[idx];
+      const G4ThreeVector x(y[0] * MM_PER_NAT * CLHEP::mm, y[1] * MM_PER_NAT * CLHEP::mm, y[2] * MM_PER_NAT * CLHEP::mm);
+      const G4ThreeVector p(y[3] * CLHEP::GeV, y[4] * CLHEP::GeV, y[5] * CLHEP::GeV);
+      dxs[idx] = (x - m_x[idx]).mag(); dps[idx] = (p - m_p[idx]).mag() / p.mag();
+      if (dxs[idx] > 1e-6 * CLHEP::mm || dps[idx] > 1e-9) same = false;
+    }
+    if (std::getenv("QUIRK_EQ3_DEBUG"))
+      G4cout << "QuirkEq3Pair: slice at t=" << (m_tOffset + m_solver->t) * NS_PER_NAT << " ns, s_cur " << m_sCur[0] << " " << m_sCur[1] << " s_H " << m_sH[0] << " "
+             << m_sH[1] << " mm, |dx| " << dxs[0] << " " << dxs[1] << " mm, |dp|/p " << dps[0] << " " << dps[1] << (same ? "" : "  -> RESTART") << G4endl;
+    if (!same) {
+      NewSolver(m_tOffset + m_solver->t);
+      ++m_restarts;
+    }
+  }
+  const double t_end = m_tOffset + m_solver->t + s_slice / CLHEP::ns / NS_PER_NAT;
+  while (m_tOffset + m_solver->t < t_end) {
+    if (m_solver->Step() < 0) {
+      G4Exception("QuirkEq3Pair::IntegrateSlice", "QuirkEq3Step", EventMustBeAborted, "eq3: DOP853 step size too small");
+      m_alive[0] = m_alive[1] = false;
+      return;
+    }
+    StepRec r;
+    r.t_old = m_tOffset + m_solver->t_old;
+    r.h = m_solver->h;
+    std::copy(m_solver->y_old, m_solver->y_old + 12, r.y_old);
+    for (int i = 0; i < 7; ++i) std::copy(m_solver->F[i], m_solver->F[i] + 12, r.F[i]);
+    for (int k = 0; k < 2; ++k) {
+      r.s0[k] = m_steps.empty() ? 0.0 : m_steps.back().s1[k];
+      r.s1[k] = r.s0[k] + PathInStep(r, k, 1.0);
+    }
+    m_steps.push_back(r);
+  }
+  for (int idx = 0; idx < 2; ++idx) m_sH[idx] = m_steps.back().s1[m_slot[idx]];
+  // drop the steps both tracks have passed
+  while (m_steps.size() > 1 && m_steps.front().s1[m_slot[0]] < m_sCur[0] && m_steps.front().s1[m_slot[1]] < m_sCur[1]) m_steps.pop_front();
+}
+
+double QuirkEq3Pair::PathInStep(const StepRec& r, int slot, double x) const {
+  if (x <= 0) return 0.0;
+  const double m = m_par.mass;
+  double y[12], sum = 0;
+  for (int i = 0; i < 8; ++i) {
+    quirkeq3::Dense(r.F, r.y_old, GLX[i] * x, y);
+    sum += GLW[i] * Speed(y, slot, m);
+  }
+  return sum * x * r.h * MM_PER_NAT;
+}
+
+void QuirkEq3Pair::PrintCounters(const char* where) const {
+  if (!std::getenv("QUIRK_EQ3_DEBUG")) return;
+  G4cout << "QuirkEq3Pair counters (" << where << "): StateAt calls " << m_nStateAt << ", beyond the horizon (clamped) " << m_nClamp << " (max "
+         << m_maxClamp / CLHEP::mm << " mm); Stepper calls past the step's MaxLength " << m_nStepBeyond << " (max " << m_maxStepBeyond / CLHEP::mm
+         << " mm); restarts " << m_restarts << G4endl;
+}
+
+G4bool QuirkEq3Pair::AtHorizon(int idx) const { return m_sH[idx] - m_sCur[idx] <= 1e-9 * CLHEP::mm; }
+
+G4bool QuirkEq3Pair::Ensure(int idx, const G4Track& track) {
+  m_x[idx] = track.GetPosition();                                       // actual state, for the slice-start comparison
+  m_p[idx] = track.GetMomentum();
+  if (!(m_reg[0] && m_reg[1])) return false;
+  if (!AtHorizon(idx)) return true;
+  const int o = 1 - idx;
+  if (!m_alive[o] || !AtHorizon(o)) return false;
+  IntegrateSlice();
+  return m_alive[idx] && !AtHorizon(idx);
+}
+
+G4double QuirkEq3Pair::MaxLength(int idx) const {
+  if (!(m_reg[0] && m_reg[1])) return 0.0;
+  return std::max(0.0, m_sH[idx] - m_sCur[idx]);
+}
+
+void QuirkEq3Pair::StateAt(int idx, G4double s, G4double y9[9]) const {
+  const int slot = m_slot[idx];
+  ++m_nStateAt;
+  if (s > m_sH[idx]) { ++m_nClamp; m_maxClamp = std::max(m_maxClamp, s - m_sH[idx]); }
+  s = std::min(std::max(s, 0.0), m_sH[idx]);
+  // the step that contains s
+  auto it = std::lower_bound(m_steps.begin(), m_steps.end(), s, [slot](const StepRec& r, double v) { return r.s1[slot] < v; });
+  if (it == m_steps.end()) it = std::prev(m_steps.end());
+  const StepRec& r = *it;
+  const double target = s - r.s0[slot], len = r.s1[slot] - r.s0[slot];
+  double x = len > 0 ? std::min(std::max(target / len, 0.0), 1.0) : 1.0;
+  double y[12];
+  for (int k = 0; k < 40 && len > 0; ++k) {                           // Newton on the path length
+    quirkeq3::Dense(r.F, r.y_old, x, y);
+    const double v = Speed(y, slot, m_par.mass) * r.h * MM_PER_NAT;
+    const double dx = (PathInStep(r, slot, x) - target) / v;
+    x = std::min(std::max(x - dx, 0.0), 1.0);
+    if (std::abs(dx) < 1e-15) break;
+  }
+  quirkeq3::Dense(r.F, r.y_old, x, y);
+  const double* q = y + 6 * slot;
+  y9[0] = q[0] * MM_PER_NAT * CLHEP::mm;
+  y9[1] = q[1] * MM_PER_NAT * CLHEP::mm;
+  y9[2] = q[2] * MM_PER_NAT * CLHEP::mm;
+  y9[3] = q[3] * CLHEP::GeV;
+  y9[4] = q[4] * CLHEP::GeV;
+  y9[5] = q[5] * CLHEP::GeV;
+  const double p2 = y9[3] * y9[3] + y9[4] * y9[4] + y9[5] * y9[5];
+  y9[6] = p2 / (std::sqrt(p2 + m_mass * m_mass) + m_mass);           // Ekin without cancellation
+  y9[7] = m_t0 + (r.t_old + x * r.h) * NS_PER_NAT * CLHEP::ns;
+}
diff --git a/quirkcore/test/eq3_dop853_cli.cc b/quirkcore/test/eq3_dop853_cli.cc
new file mode 100644
index 0000000..a85de0d
--- /dev/null
+++ b/quirkcore/test/eq3_dop853_cli.cc
@@ -0,0 +1,42 @@
+// Standalone driver for quirkeq3::Integrate (09 patch, 2026-11-24), used by coplanarity_study/09_.../g4/G14_cpp_dop853_vs_numba.py.
+// Input  (binary doubles): y0[12], t_end, mass, q1, q2, L2, Bz, rtol, atol[12], nR, R2n[nR], nZ, Zn[nZ], ncoarse, nfine, max_out
+// Output (binary doubles): status, nacc, nrej, nfev, npts, T[npts], Y[npts * 12]
+// Build: g++ -O2 -std=c++17 -I../include eq3_dop853_cli.cc ../src/QuirkEq3Dop853.cc -o eq3_dop853_cli
+#include "quirkcore/QuirkEq3Dop853.h"
+#include <cstdio>
+#include <vector>
+
+int main(int argc, char** argv) {
+  if (argc != 3) { std::fprintf(stderr, "usage: eq3_dop853_cli <in.bin> <out.bin>\n"); return 2; }
+  std::FILE* fi = std::fopen(argv[1], "rb");
+  if (!fi) return 3;
+  std::vector<double> v;
+  double x;
+  while (std::fread(&x, sizeof(double), 1, fi) == 1) v.push_back(x);
+  std::fclose(fi);
+  size_t k = 0;
+  auto get = [&]() { return v.at(k++); };
+  double y0[12], atol[12];
+  for (double& a : y0) a = get();
+  const double t_end = get();
+  quirkeq3::Params p;
+  p.mass = get(); p.q1 = get(); p.q2 = get(); p.L2 = get(); p.Bz = get();
+  const double rtol = get();
+  for (double& a : atol) a = get();
+  std::vector<double> R2n(static_cast<size_t>(get()));
+  for (double& a : R2n) a = get();
+  std::vector<double> Zn(static_cast<size_t>(get()));
+  for (double& a : Zn) a = get();
+  const int ncoarse = static_cast<int>(get()), nfine = static_cast<int>(get());
+  const long max_out = static_cast<long>(get());
+  const quirkeq3::Result R = quirkeq3::Integrate(y0, t_end, p, rtol, atol, R2n, Zn, ncoarse, nfine, max_out);
+  std::FILE* fo = std::fopen(argv[2], "wb");
+  if (!fo) return 4;
+  const double hdr[5] = {static_cast<double>(R.status), static_cast<double>(R.nacc), static_cast<double>(R.nrej), static_cast<double>(R.nfev),
+                         static_cast<double>(R.T.size())};
+  std::fwrite(hdr, sizeof(double), 5, fo);
+  std::fwrite(R.T.data(), sizeof(double), R.T.size(), fo);
+  std::fwrite(R.Y.data(), sizeof(double), R.Y.size(), fo);
+  std::fclose(fo);
+  return 0;
+}
diff --git a/quirkcore/test/eq3_pathlen_test.cc b/quirkcore/test/eq3_pathlen_test.cc
new file mode 100644
index 0000000..5e7cd93
--- /dev/null
+++ b/quirkcore/test/eq3_pathlen_test.cc
@@ -0,0 +1,58 @@
+// 09 debug test (2026-11-24): the 8-point Gauss-Legendre path length per DOP853 step (as QuirkEq3Pair::PathInStep) against a composite
+// Simpson integral with 4000 sub-intervals of |v| from the same dense output, for every accepted step of one pair.
+// Input: px1 py1 pz1 px2 py2 pz2 (GeV; quirk 1 charge +1, quirk 2 charge -1), mass (GeV), Lambda (GeV), t_stop (ns), B (T).
+// Build: g++ -O2 -std=c++17 -ffp-contract=off -I../include eq3_pathlen_test.cc ../src/QuirkEq3Dop853.cc -o eq3_pathlen_test
+#include "quirkcore/QuirkEq3Dop853.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
+static const double GLX[8] = {0.019855071751231856, 0.10166676129318664, 0.2372337950418355, 0.4082826787521751,
+                              0.5917173212478249, 0.7627662049581645, 0.8983332387068134, 0.9801449282487681};
+static const double GLW[8] = {0.05061426814518813, 0.11119051722668724, 0.15685332293894364, 0.18134189168918100,
+                              0.18134189168918100, 0.15685332293894364, 0.11119051722668724, 0.05061426814518813};
+static double speed(const double y[12], int slot, double m) {
+  const double* p = y + 6 * slot + 3;
+  const double p2 = p[0] * p[0] + p[1] * p[1] + p[2] * p[2];
+  return std::sqrt(p2) / std::sqrt(p2 + m * m);
+}
+
+int main(int argc, char** argv) {
+  if (argc != 11) { std::fprintf(stderr, "usage: px1 py1 pz1 px2 py2 pz2 mass Lambda t_stop_ns B_T\n"); return 2; }
+  double a[10];
+  for (int i = 0; i < 10; ++i) a[i] = std::atof(argv[i + 1]);
+  const double CM = 1.973269804e-14, NS = 6.582119569e-16;
+  double y0[12] = {0, 0, 0, a[0], a[1], a[2], 0, 0, 0, a[3], a[4], a[5]};
+  quirkeq3::Params p;
+  p.mass = a[6]; p.q1 = 0.30282212; p.q2 = -0.30282212; p.L2 = a[7] * a[7]; p.Bz = a[9] * 1.9535e-16;
+  double atol[12];
+  for (int k = 0; k < 2; ++k) { for (int j = 0; j < 3; ++j) atol[6 * k + j] = 1e-7 / CM; for (int j = 3; j < 6; ++j) atol[6 * k + j] = 1e-10; }
+  quirkeq3::Solver S(y0, a[8] / NS, p, 1e-10, atol);
+  double worst = 0, worst_t = 0, worst_h = 0, sum_gl[2] = {0, 0}, sum_fine[2] = {0, 0};
+  long nsteps = 0;
+  while (!S.Done()) {
+    if (S.Step() < 0) { std::printf("step too small\n"); return 1; }
+    ++nsteps;
+    double y[12];
+    for (int k = 0; k < 2; ++k) {
+      double gl = 0;
+      for (int i = 0; i < 8; ++i) { quirkeq3::Dense(S.F, S.y_old, GLX[i], y); gl += GLW[i] * speed(y, k, p.mass); }
+      const int N = 4000;
+      double fine = 0;
+      for (int i = 0; i <= N; ++i) {
+        quirkeq3::Dense(S.F, S.y_old, static_cast<double>(i) / N, y);
+        fine += (i == 0 || i == N ? 1 : (i % 2 ? 4 : 2)) * speed(y, k, p.mass);
+      }
+      fine /= 3.0 * N;
+      sum_gl[k] += gl * S.h; sum_fine[k] += fine * S.h;
+      const double rel = std::abs(gl - fine) / fine;
+      if (rel > worst) { worst = rel; worst_t = S.t_old * NS; worst_h = S.h * NS; }
+    }
+  }
+  std::printf("steps %ld; worst per-step relative error of the 8-point Gauss-Legendre path length %.3e (step at t = %.6f ns, h = %.3e ns)\n",
+              nsteps, worst, worst_t, worst_h);
+  for (int k = 0; k < 2; ++k)
+    std::printf("quirk %d: total path GL %.9f mm, fine %.9f mm, difference %.3e um\n", k + 1, sum_gl[k] * CM * 10, sum_fine[k] * CM * 10,
+                (sum_gl[k] - sum_fine[k]) * CM * 10 * 1e3);
+  return 0;
+}
