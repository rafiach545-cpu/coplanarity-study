diff --git a/quirkcore/include/quirkcore/QuirkEq3Dop853.h b/quirkcore/include/quirkcore/QuirkEq3Dop853.h
new file mode 100644
index 0000000..b5e2286
--- /dev/null
+++ b/quirkcore/include/quirkcore/QuirkEq3Dop853.h
@@ -0,0 +1,58 @@
+#ifndef QUIRKCORE_QuirkEq3Dop853_H
+#define QUIRKCORE_QuirkEq3Dop853_H
+// Eq. 3 of arXiv:1708.02243 for a quirk pair, integrated with an error-controlled DOP853 (09 patch, 2026-11-24).
+// C++ port, line by line, of coplanarity_study/03_trajectory_sim/quirk_trajectory_dop853.py (_integrate, _dense, _rr) and of the
+// right-hand side quirk_trajectory_numba._rhs / _string_force; scipy's DOP853 controller (SAFETY 0.9, factor in [0.2, 10],
+// select_initial_step, 7th-order dense output). Pure C++ (no Geant4 types), natural units (GeV, GeV^-1), so it can be tested
+// standalone against the numba module (G14: bitwise identical) and used by the Geant4 stepper (QuirkEq3Pair).
+// State y[12] = x1(3), p1(3), x2(3), p2(3). No random numbers anywhere.
+#include <vector>
+#include <cstdint>
+
+namespace quirkeq3 {
+
+struct Params {
+  double mass{0};      // GeV
+  double q1{0}, q2{0}; // charge * e_charge_natural
+  double L2{0};        // Lambda^2 (GeV^2)
+  double Bz{0};        // B_tesla * TESLA_TO_GEV2 (GeV^2)
+};
+
+// dy/dt for Eq. 3 with a uniform Bz (same arithmetic as quirk_trajectory_numba._rhs)
+void Rhs(const double y[12], const Params& p, double out[12]);
+
+// One accepted DOP853 step and its dense output: y(t_old + x h) = Dense(F, y_old, x), x in [0, 1].
+void Dense(const double F[7][12], const double y_old[12], double x, double out[12]);
+
+// The integrator one accepted step at a time; the step sequence is that of quirk_trajectory_dop853._integrate.
+class Solver {
+public:
+  Solver(const double y0[12], double t_end, const Params& p, double rtol, const double atol[12]);
+  // one accepted step (with its rejected trials): 0 ok, -1 step too small; after it t_old, h, y_old, F, y describe the step
+  int Step();
+  bool Done() const { return !(t < t_end); }
+  double t{0};          // after Step(): end of the step
+  double t_old{0}, h{0};
+  double y[12]{}, y_old[12]{}, F[7][12]{};
+  long nacc{0}, nrej{0}, nfev{0};
+private:
+  Params m_p;
+  double m_rtol, m_atol[12], t_end;
+  double f[12]{}, h_abs{0};
+};
+
+struct Result {
+  std::vector<double> T;              // GeV^-1
+  std::vector<double> Y;              // 12 per point, row major
+  int status{0};                      // 0 ok, -1 step too small, -2 more than max_out points
+  long nacc{0}, nrej{0}, nfev{0};
+};
+
+// Same as quirk_trajectory_dop853._integrate: from t = 0 to t_end, written points = step ends, plus, where a radius (R2n: squared radii)
+// or a disk plane (Zn) is crossed inside a coarse sub-interval, nfine dense points (ncoarse coarse points per step); without radii and
+// planes every coarse point is written.
+Result Integrate(const double y0[12], double t_end, const Params& p, double rtol, const double atol[12],
+                 const std::vector<double>& R2n, const std::vector<double>& Zn, int ncoarse, int nfine, long max_out);
+
+}  // namespace quirkeq3
+#endif
